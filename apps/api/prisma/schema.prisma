generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & tenancy ----------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum TenantOrigin {
  SEED
  ADMIN
  SIGNUP
}

model Tenant {
  id          String        @id @default(cuid())
  name        String
  status      TenantStatus  @default(TRIAL)
  trialEndsAt DateTime?
  onboardedAt DateTime?
  createdVia  TenantOrigin  @default(SEED)
  createdAt   DateTime      @default(now())

  brands Brand[]
  users  User[]
  roles  Role[]

  @@map("tenants")
}

model Brand {
  id       String @id @default(cuid())
  tenantId String
  name     String
  themeId  String @default("counter")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  outlets Outlet[]

  @@index([tenantId])
  @@map("brands")
}

model Outlet {
  id             String  @id @default(cuid())
  tenantId       String
  brandId        String
  name           String
  address        String?
  gstin          String?
  nextBillNumber Int     @default(1)
  nextKotNumber  Int     @default(1)
  // Loyalty: points earned = round(billTotal * earnRate); 1 point = pointValue rupees.
  loyaltyEarnRate  Decimal @default(0.1) @db.Decimal(6, 4)
  loyaltyPointValue Decimal @default(1) @db.Decimal(6, 2)
  upiVpa           String? // payee VPA for dynamic UPI QR (e.g. stellokitchens@okhdfc)
  placeOfSupply    String? // GST state code, e.g. "29" (Karnataka)
  isCentralKitchen Boolean @default(false) // commissary that supplies satellite outlets
  publicToken      String? @unique // opaque token for kiosk / token-display board URLs

  brand       Brand          @relation(fields: [brandId], references: [id])
  terminals   Terminal[]
  userOutlets UserOutlet[]
  categories  MenuCategory[]
  stations    Station[]
  channels    Channel[]
  areas       Area[]
  tables      DiningTable[]
  orders      Order[]
  rawMaterials RawMaterial[]
  vendors      Vendor[]
  customers    Customer[]
  coupons      Coupon[]
  campaigns    Campaign[]
  feedback     Feedback[]
  cashSessions CashSession[]
  orderRequests OrderRequest[]

  @@index([tenantId])
  @@map("outlets")
}

// A managed device in the outlet's fleet: POS counters, KDS screens, printers, etc.
model Terminal {
  id          String    @id @default(cuid())
  tenantId    String
  outletId    String
  name        String
  type        String    @default("POS") // POS | KDS | PRINTER | KIOSK | DISPLAY
  deviceToken String    @unique @default(cuid())
  config      Json? // per-type settings (printer paper width, KDS theme, …)
  isActive    Boolean   @default(true)
  lastSeenAt  DateTime?

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@index([tenantId, outletId])
  @@map("terminals")
}

model Role {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  permissions Json // string[] of permission keys

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id           String  @id @default(cuid())
  tenantId     String
  email        String  @unique
  passwordHash String
  name         String
  roleId       String
  isActive     Boolean @default(true)
  isPlatformAdmin Boolean @default(false)
  emailVerified   Boolean @default(false)
  tokenVersion Int @default(0)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  role        Role         @relation(fields: [roleId], references: [id])
  userOutlets UserOutlet[]
  auditLogs   AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model UserOutlet {
  userId   String
  outletId String

  user   User   @relation(fields: [userId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])

  @@id([userId, outletId])
  @@map("user_outlets")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------- Menu / catalog ----------

model Station {
  id          String @id @default(cuid())
  tenantId    String
  outletId    String
  name        String
  sortOrder   Int    @default(0)
  prepMinutes Int    @default(10) // target prep time; drives KDS ageing colours

  outlet     Outlet         @relation(fields: [outletId], references: [id])
  categories MenuCategory[]

  @@index([tenantId, outletId])
  @@map("stations")
}

model MenuCategory {
  id        String    @id @default(cuid())
  tenantId  String
  outletId  String
  stationId String?
  name      String
  sortOrder Int       @default(0)
  deletedAt DateTime?

  outlet  Outlet   @relation(fields: [outletId], references: [id])
  station Station? @relation(fields: [stationId], references: [id])
  items   Item[]
  combos  Combo[]

  @@index([tenantId, outletId])
  @@map("menu_categories")
}

model Item {
  id             String    @id @default(cuid())
  tenantId       String
  outletId       String
  categoryId     String
  name           String
  shortCode      String?
  price          Decimal   @db.Decimal(10, 2)
  isVeg          Boolean   @default(true)
  inStock        Boolean   @default(true)
  taxRate        Decimal   @default(5) @db.Decimal(5, 2)
  hsnCode        String?   @default("996331") // SAC for restaurant service
  sortOrder      Int       @default(0)
  availableStart String? // "HH:MM" local; null = all day (e.g. breakfast till 11:00)
  availableEnd   String?
  deletedAt      DateTime?
  imageUrl       String? // public URL of the dish photo (local disk or S3-compatible storage)

  category      MenuCategory       @relation(fields: [categoryId], references: [id])
  variations    ItemVariation[]
  addonGroups   ItemAddonGroup[]
  channelPrices ItemChannelPrice[]
  menuMaps      AggregatorMenuMap[]
  recipe        RecipeIngredient[]
  comboOptions  ComboSlotOption[]

  @@index([tenantId, outletId])
  @@map("items")
}

model Channel {
  id        String  @id @default(cuid())
  tenantId  String
  outletId  String
  name      String // "Dine-in", "Zomato", "Swiggy"
  kind      String  @default("DIRECT") // DIRECT | AGGREGATOR
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  outlet   Outlet              @relation(fields: [outletId], references: [id])
  prices   ItemChannelPrice[]
  menuMaps AggregatorMenuMap[]

  @@index([tenantId, outletId])
  @@map("channels")
}

// Per-channel price override + listing flag (absorb aggregator commission).
model ItemChannelPrice {
  id        String  @id @default(cuid())
  itemId    String
  channelId String
  price     Decimal @db.Decimal(10, 2)
  isListed  Boolean @default(true)

  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([itemId, channelId])
  @@map("item_channel_prices")
}

// Internal item ↔ external (Zomato/Swiggy) item id, for later menu push.
model AggregatorMenuMap {
  id         String @id @default(cuid())
  itemId     String
  channelId  String
  externalId String

  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([itemId, channelId])
  @@map("aggregator_menu_maps")
}

model ItemVariation {
  id     String  @id @default(cuid())
  itemId String
  name   String
  price  Decimal @db.Decimal(10, 2)

  item Item @relation(fields: [itemId], references: [id])

  @@map("item_variations")
}

model AddonGroup {
  id        String @id @default(cuid())
  tenantId  String
  outletId  String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)

  addons Addon[]
  items  ItemAddonGroup[]

  @@map("addon_groups")
}

model Addon {
  id      String  @id @default(cuid())
  groupId String
  name    String
  price   Decimal @db.Decimal(10, 2)

  group AddonGroup @relation(fields: [groupId], references: [id])

  @@map("addons")
}

model ItemAddonGroup {
  itemId       String
  addonGroupId String

  item  Item       @relation(fields: [itemId], references: [id])
  group AddonGroup @relation(fields: [addonGroupId], references: [id])

  @@id([itemId, addonGroupId])
  @@map("item_addon_groups")
}

// ---------- Combos (bundled meals) ----------

// A sellable bundle priced as one line; explodes into component items for the
// kitchen and inventory. Appears in the menu alongside items.
model Combo {
  id         String    @id @default(cuid())
  tenantId   String
  outletId   String
  categoryId String
  name       String
  price      Decimal   @db.Decimal(10, 2)
  isVeg      Boolean   @default(true)
  inStock    Boolean   @default(true)
  taxRate    Decimal   @default(5) @db.Decimal(5, 2)
  hsnCode    String?   @default("996331")
  sortOrder  Int       @default(0)
  deletedAt  DateTime?

  category MenuCategory @relation(fields: [categoryId], references: [id])
  slots    ComboSlot[]

  @@index([tenantId, outletId])
  @@map("combos")
}

// A "choose one" slot in a combo (e.g. "Main", "Drink").
model ComboSlot {
  id        String @id @default(cuid())
  comboId   String
  name      String
  sortOrder Int    @default(0)

  combo   Combo             @relation(fields: [comboId], references: [id], onDelete: Cascade)
  options ComboSlotOption[]

  @@map("combo_slots")
}

// An item that can fill a slot; priceDelta lets a premium pick add cost.
model ComboSlotOption {
  id         String  @id @default(cuid())
  slotId     String
  itemId     String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  isDefault  Boolean @default(false)

  slot ComboSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  item Item      @relation(fields: [itemId], references: [id])

  @@map("combo_slot_options")
}

// ---------- Floor ----------

model Area {
  id       String @id @default(cuid())
  tenantId String
  outletId String
  name     String

  outlet Outlet        @relation(fields: [outletId], references: [id])
  tables DiningTable[]

  @@map("areas")
}

model DiningTable {
  id          String  @id @default(cuid())
  tenantId    String
  outletId    String
  areaId      String
  name        String
  seats       Int     @default(4)
  publicToken String? @unique // opaque token embedded in the table's Scan & Order QR

  area          Area           @relation(fields: [areaId], references: [id])
  outlet        Outlet         @relation(fields: [outletId], references: [id])
  orders        Order[]
  orderRequests OrderRequest[]

  @@map("dining_tables")
}

// ---------- Orders ----------

model Order {
  id             String    @id @default(cuid())
  tenantId       String
  outletId       String
  billNumber     String?
  orderType      String // DINE_IN | TAKEAWAY | DELIVERY
  status         String    @default("OPEN") // OPEN | BILLED | SETTLED | CANCELLED
  tableId        String?
  customerName   String?
  customerPhone  String?
  customerId     String?
  couponCode     String?
  deviceId       String? // edge device that created this order offline
  clientId       String? // device-local id, for sync idempotency
  offlineRef     String? // provisional device reference (NOT the tax-invoice number)
  subtotal       Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(10, 2)
  total          Decimal   @default(0) @db.Decimal(10, 2)
  version        Int       @default(1)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  // Billing controls: service charge (snapshot of outlet config), round-off, split/merge.
  serviceChargeAmount       Decimal @default(0) @db.Decimal(10, 2)
  serviceChargeRate         Decimal @default(0) @db.Decimal(5, 2)
  serviceChargeTaxable      Boolean @default(false)
  serviceChargeWaived       Boolean @default(false)
  serviceChargeWaivedReason String?
  roundOff                  Decimal @default(0) @db.Decimal(10, 2)
  allocatedDiscount         Decimal @default(0) @db.Decimal(10, 2) // split check's share of a parent discount
  parentOrderId             String? // split check → its parent bill
  splitIndex                Int?
  splitCount                Int? // set on the parent once split
  mergedIntoOrderId         String?

  outlet   Outlet         @relation(fields: [outletId], references: [id])
  table    DiningTable?   @relation(fields: [tableId], references: [id])
  customer Customer?      @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  kots     Kot[]
  payments OrderPayment[]

  @@unique([deviceId, clientId])
  @@index([tenantId, outletId, status])
  @@index([outletId, updatedAt])
  @@index([parentOrderId])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  itemId        String
  itemName      String
  variationId   String?
  variationName String?
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  lineTotal     Decimal @db.Decimal(10, 2)
  taxRate       Decimal @default(5) @db.Decimal(5, 2)
  note          String?
  kotId         String?
  stationId     String? // snapshot of the item's kitchen station at punch time
  prepStatus    String    @default("PENDING") // PENDING | PREPARING | READY (KDS)
  preppedAt     DateTime? // when marked READY; drives the Ready column window
  // Combos: a combo punches as one priced parent line (isComboComponent=false, no KOT)
  // plus zero-priced component lines (isComboComponent=true) that route to the kitchen.
  comboId          String? // the combo this line belongs to (parent + components)
  comboGroupId     String? // groups one combo instance's parent + components in an order
  isComboComponent Boolean @default(false)
  splitFromItemId  String? // split check copy → the parent line it bills
  splitParts       Int? // equal split: this line is a 1/N share (reports count qty / N)

  order  Order            @relation(fields: [orderId], references: [id])
  kot    Kot?             @relation(fields: [kotId], references: [id])
  addons OrderItemAddon[]

  @@index([orderId])
  @@index([stationId, prepStatus])
  @@map("order_items")
}

model OrderItemAddon {
  id          String  @id @default(cuid())
  orderItemId String
  addonId     String
  name        String
  price       Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("order_item_addons")
}

model Kot {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String
  orderId   String
  kotNumber Int
  status    String   @default("PENDING") // PENDING | READY | SERVED
  createdAt DateTime @default(now())

  order Order       @relation(fields: [orderId], references: [id])
  items OrderItem[]

  @@index([tenantId, outletId, status])
  @@map("kots")
}

model OrderPayment {
  id        String   @id @default(cuid())
  orderId   String
  mode      String // CASH | CARD | UPI | WALLET | OTHER
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_payments")
}

// ---------- Inventory ----------

model RawMaterial {
  id             String    @id @default(cuid())
  tenantId       String
  outletId       String
  name           String
  unit           String // KG | G | L | ML | PCS
  stockQty       Decimal   @default(0) @db.Decimal(12, 3) // running balance
  reorderLevel   Decimal   @default(0) @db.Decimal(12, 3)
  costPerUnit    Decimal   @default(0) @db.Decimal(12, 4) // weighted average
  isSemiFinished Boolean   @default(false) // produced in-house from a prep recipe
  deletedAt      DateTime?

  outlet      Outlet             @relation(fields: [outletId], references: [id])
  ingredients RecipeIngredient[]
  movements   StockMovement[]
  // Multi-stage recipes: this material's own prep recipe, and uses of it as an input.
  prepRecipe  PrepRecipeIngredient[] @relation("PrepOutput")
  prepInputs  PrepRecipeIngredient[] @relation("PrepInput")

  @@index([tenantId, outletId])
  @@map("raw_materials")
}

// One line of a semi-finished good's prep recipe: quantity of an input material
// per 1 unit of the produced output material.
model PrepRecipeIngredient {
  id               String  @id @default(cuid())
  outputMaterialId String
  inputMaterialId  String
  quantity         Decimal @db.Decimal(12, 4)

  output RawMaterial @relation("PrepOutput", fields: [outputMaterialId], references: [id], onDelete: Cascade)
  input  RawMaterial @relation("PrepInput", fields: [inputMaterialId], references: [id])

  @@unique([outputMaterialId, inputMaterialId])
  @@map("prep_recipe_ingredients")
}

// One line of an item's recipe: quantity of a raw material per unit of the dish.
model RecipeIngredient {
  id            String  @id @default(cuid())
  itemId        String
  rawMaterialId String
  quantity      Decimal @db.Decimal(12, 3)

  item     Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  material RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([itemId, rawMaterialId])
  @@map("recipe_ingredients")
}

model Vendor {
  id        String    @id @default(cuid())
  tenantId  String
  outletId  String
  name      String
  phone     String?
  deletedAt DateTime?

  outlet    Outlet          @relation(fields: [outletId], references: [id])
  movements StockMovement[]

  @@map("vendors")
}

// ---------- Aggregator orders ----------

model AggregatorOrder {
  id                  String   @id @default(cuid())
  tenantId            String
  outletId            String
  platform            String // ZOMATO | SWIGGY | ONDC | URBANPIPER
  externalOrderId     String
  orderId             String? // internal Order id once ingested
  status              String   @default("RECEIVED") // RECEIVED | ACCEPTED | PREPARING | READY | PICKED_UP | DELIVERED | REJECTED | CANCELLED
  customerName        String?
  customerPhoneMasked String?
  orderValue          Decimal  @db.Decimal(10, 2)
  unmatchedItems      Json? // external item ids that had no internal mapping
  rawPayload          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([platform, externalOrderId])
  @@index([tenantId, outletId, status])
  @@map("aggregator_orders")
}

// ---------- CRM / loyalty / marketing ----------

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  outletId      String
  name          String?
  phone         String
  email         String?
  loyaltyPoints Int      @default(0)
  totalOrders   Int      @default(0)
  totalSpent    Decimal  @default(0) @db.Decimal(12, 2)
  lastVisitAt   DateTime?
  createdAt     DateTime @default(now())

  outlet       Outlet               @relation(fields: [outletId], references: [id])
  orders       Order[]
  transactions LoyaltyTransaction[]
  feedback     Feedback[]

  @@unique([outletId, phone])
  @@index([tenantId, outletId])
  @@map("customers")
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  type       String // EARN | REDEEM | TOPUP | ADJUST
  points     Int // signed: + earn/topup, - redeem
  orderId    String?
  note       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("loyalty_transactions")
}

model Coupon {
  id          String    @id @default(cuid())
  tenantId    String
  outletId    String
  code        String
  type        String // PERCENT | FLAT
  value       Decimal   @db.Decimal(10, 2)
  minOrder    Decimal   @default(0) @db.Decimal(10, 2)
  maxDiscount Decimal?  @db.Decimal(10, 2)
  validFrom   DateTime?
  validTo     DateTime?
  usageLimit  Int? // null = unlimited
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([outletId, code])
  @@map("coupons")
}

model Campaign {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String
  name      String
  channel   String // SMS | WHATSAPP | EMAIL
  segment   String // ALL | NEW | REGULAR | VIP | LAPSED
  message   String
  sentCount Int      @default(0)
  status    String   @default("DRAFT") // DRAFT | SENT
  createdAt DateTime @default(now())

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@map("campaigns")
}

model Feedback {
  id         String   @id @default(cuid())
  tenantId   String
  outletId   String
  orderId    String?
  customerId String?
  rating     Int // 1..5
  comment    String?
  createdAt  DateTime @default(now())

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, outletId, createdAt])
  @@map("feedback")
}

// ---------- Cash management + payments ----------

model CashSession {
  id           String    @id @default(cuid())
  tenantId     String
  outletId     String
  openedById   String?
  openingFloat Decimal   @db.Decimal(10, 2)
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  countedCash  Decimal?  @db.Decimal(10, 2)
  status       String    @default("OPEN") // OPEN | CLOSED

  outlet    Outlet         @relation(fields: [outletId], references: [id])
  movements CashMovement[]

  @@index([tenantId, outletId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id        String   @id @default(cuid())
  sessionId String
  type      String // SALE | PAY_IN | PAY_OUT | EXPENSE | REFUND
  amount    Decimal  @db.Decimal(10, 2) // signed: + cash in, - cash out
  category  String? // for EXPENSE
  note      String?
  orderId   String?
  createdAt DateTime @default(now())

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("cash_movements")
}

model Refund {
  id         String   @id @default(cuid())
  tenantId   String
  outletId   String
  orderId    String
  amount     Decimal  @db.Decimal(10, 2)
  mode       String // CASH | CARD | UPI | WALLET | OTHER
  reason     String?
  gatewayRef String?
  // PENDING and UNKNOWN reserve balance until provider reconciliation.
  status     String   @default("PROCESSED")
  requestKey String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, outletId, orderId, requestKey])
  @@index([orderId])
  @@index([tenantId, outletId])
  @@map("refunds")
}

// ---------- GST e-invoicing ----------

// A tax invoice for a settled order. IRN/signed-QR/ack are returned by the GSP/IRP
// and stored here — we never build GSTN plumbing ourselves.
model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String
  orderId       String    @unique
  invoiceNumber String
  invoiceDate   DateTime  @default(now())
  sellerGstin   String?
  buyerGstin    String?
  placeOfSupply String?
  taxableValue  Decimal   @db.Decimal(12, 2)
  cgst          Decimal   @db.Decimal(12, 2)
  sgst          Decimal   @db.Decimal(12, 2)
  igst          Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  hsnSummary    Json? // [{ hsn, taxable, rate, cgst, sgst }]
  irn           String? // IRN returned by the IRP
  signedQr      String? // signed QR payload (rendered as the invoice QR)
  ackNo         String?
  ackDate       DateTime?
  status        String    @default("PENDING") // PENDING | GENERATED | CANCELLED
  createdAt     DateTime  @default(now())

  @@index([tenantId, outletId])
  @@map("invoices")
}

// ---------- Central kitchen / commissary ----------

// A satellite outlet's stock request to the central kitchen.
model Indent {
  id           String    @id @default(cuid())
  tenantId     String
  fromOutletId String // requesting (satellite) outlet
  toOutletId   String // central kitchen
  status       String    @default("DRAFT") // DRAFT | DISPATCHED | RECEIVED | CANCELLED
  note         String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
  receivedAt   DateTime?

  items    IndentItem[]
  ewayBill EwayBill?

  @@index([tenantId, fromOutletId])
  @@index([tenantId, toOutletId])
  @@map("indents")
}

model IndentItem {
  id            String  @id @default(cuid())
  indentId      String
  rawMaterialId String // material at the central kitchen
  materialName  String
  unit          String
  requestedQty  Decimal @db.Decimal(12, 3)
  dispatchedQty Decimal @default(0) @db.Decimal(12, 3)
  unitCost      Decimal @default(0) @db.Decimal(12, 4)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@map("indent_items")
}

// E-way bill for the goods movement (generated via a GSP, like the IRN flow).
model EwayBill {
  id          String    @id @default(cuid())
  tenantId    String
  indentId    String    @unique
  ewbNo       String
  value       Decimal   @db.Decimal(12, 2)
  fromGstin   String?
  toGstin     String?
  distanceKm  Int?
  validUntil  DateTime?
  status      String    @default("GENERATED")
  generatedAt DateTime  @default(now())

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@map("eway_bills")
}

// Append-only ledger; RawMaterial.stockQty is the denormalised running balance.
model StockMovement {
  id            String   @id @default(cuid())
  tenantId      String
  outletId      String
  rawMaterialId String
  type          String // RECEIPT | CONSUMPTION | WASTAGE | ADJUSTMENT
  quantity      Decimal  @db.Decimal(12, 3) // signed: + inward, - outward
  unitCost      Decimal? @db.Decimal(12, 4)
  reason        String?
  vendorId      String?
  refType       String? // e.g. "kot"
  refId         String?
  createdById   String?
  createdAt     DateTime @default(now())

  material RawMaterial @relation(fields: [rawMaterialId], references: [id])
  vendor   Vendor?     @relation(fields: [vendorId], references: [id])

  @@index([tenantId, outletId, createdAt])
  @@index([rawMaterialId])
  @@map("stock_movements")
}

// ---------- First-party online ordering (Scan & Order / kiosk) ----------

// A diner-submitted cart that a staff member must validate before it becomes a
// real order + KOT. Keeps unauthenticated diners from firing kitchen tickets.
model OrderRequest {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String
  tableId       String? // null for kiosk / takeaway
  mode          String    @default("DINE_IN") // DINE_IN | TAKEAWAY
  customerName  String?
  customerPhone String?
  items         Json // [{ itemId, variationId?, addonIds?, quantity, note? }]
  combos        Json? // [{ comboId, quantity, selections: [{ slotId, itemId }], note? }]
  note          String?
  status        String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  token         String    @unique @default(cuid()) // diner polls status with this
  orderId       String? // the real order created on acceptance
  tokenNumber   Int? // short number shown on the token-display board
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  outlet Outlet       @relation(fields: [outletId], references: [id])
  table  DiningTable? @relation(fields: [tableId], references: [id])

  @@index([tenantId, outletId, status])
  @@map("order_requests")
}

// ---------- Loyalty redemption OTP ----------

// A one-time code that gates points redemption at billing (sent to the customer's
// phone via the notification provider; consumed when the OTP verifies at settle).
model LoyaltyOtp {
  id         String    @id @default(cuid())
  tenantId   String
  outletId   String
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([outletId, phone])
  @@map("loyalty_otps")
}

// ---------- Account lifecycle (signup, reset, invites) ----------

enum AuthTokenType {
  PASSWORD_RESET
  INVITE
}

model PendingSignup {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  restaurantName String
  ownerName      String
  tokenHash      String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@map("pending_signups")
}

model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  tenantId  String?
  userId    String?
  email     String?
  roleId    String?
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([tokenHash])
  @@map("auth_tokens")
}

// ── Staff/HR, accounting, gift cards ─────

// An employee. Linked to a User when they log in; kitchen helpers etc. may have
// no login and clock in with a PIN on the POS terminal.
model StaffMember {
  id               String    @id @default(cuid())
  tenantId         String
  outletId         String // home outlet
  userId           String?
  employeeCode     String
  name             String
  phone            String?
  designation      String?
  joiningDate      DateTime  @db.Date
  exitDate         DateTime? @db.Date
  pinHash          String? // bcrypt of a 4-6 digit clock-in PIN
  pinFailedCount   Int       @default(0)
  pinLockedUntil   DateTime?
  payType          String    @default("MONTHLY") // MONTHLY | DAILY | HOURLY
  payRate          Decimal   @default(0) @db.Decimal(12, 2)
  allowances       Json? // [{ name, amount }] monthly
  deductions       Json? // [{ name, amount }] monthly
  pfApplicable     Boolean   @default(false)
  esiApplicable    Boolean   @default(false)
  ptApplicable     Boolean   @default(false)
  overtimeEligible Boolean   @default(true)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  attendance AttendanceRecord[]
  shifts     RosterShift[]
  leaves     LeaveRequest[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@index([tenantId, outletId])
  @@map("staff_members")
}

// One clock-in to clock-out span. Several per day are allowed (split shifts).
model AttendanceRecord {
  id               String    @id @default(cuid())
  tenantId         String
  outletId         String
  staffId          String
  date             DateTime  @db.Date // IST business date of the clock-in
  clockIn          DateTime
  clockOut         DateTime?
  breakMinutes     Int       @default(0) // completed breaks
  breakStartedAt   DateTime?
  source           String    @default("PIN") // PIN | MANUAL | CORRECTED
  correctionReason String?
  correctedById    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@index([tenantId, outletId, date])
  @@index([staffId, date])
  @@map("attendance_records")
}

model ShiftTemplate {
  id           String  @id @default(cuid())
  tenantId     String
  outletId     String
  name         String
  startTime    String // "HH:MM" IST
  endTime      String // earlier than start = overnight
  breakMinutes Int     @default(30)
  graceMinutes Int     @default(10)
  isActive     Boolean @default(true)

  @@index([tenantId, outletId])
  @@map("shift_templates")
}

// A rostered shift (one per staff per day). Times are snapshotted from the template.
model RosterShift {
  id           String   @id @default(cuid())
  tenantId     String
  outletId     String
  staffId      String
  date         DateTime @db.Date
  templateId   String?
  startTime    String
  endTime      String
  breakMinutes Int      @default(30)
  graceMinutes Int      @default(10)

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([tenantId, outletId, date])
  @@map("roster_shifts")
}

model ShiftSwapRequest {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String
  fromShiftId   String
  toStaffId     String
  toShiftId     String? // null = cover (toStaff takes the shift outright)
  reason        String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, outletId, status])
  @@map("shift_swap_requests")
}

model LeaveRequest {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String
  staffId       String
  type          String // CASUAL | SICK | EARNED | UNPAID
  fromDate      DateTime  @db.Date
  toDate        DateTime  @db.Date
  halfDay       Boolean   @default(false)
  days          Decimal   @db.Decimal(5, 1)
  reason        String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@index([tenantId, outletId, status])
  @@index([staffId, fromDate])
  @@map("leave_requests")
}

model LeaveBalance {
  id       String  @id @default(cuid())
  tenantId String
  staffId  String
  year     Int
  type     String // CASUAL | SICK | EARNED
  allotted Decimal @default(0) @db.Decimal(5, 1)
  used     Decimal @default(0) @db.Decimal(5, 1)

  @@unique([staffId, year, type])
  @@index([tenantId])
  @@map("leave_balances")
}

// Tenant-wide payroll settings (statutory components are configurable).
model PayrollSetting {
  id       String @id @default(cuid())
  tenantId String @unique
  config   Json

  @@map("payroll_settings")
}

model SalaryAdvance {
  id              String   @id @default(cuid())
  tenantId        String
  outletId        String
  staffId         String
  amount          Decimal  @db.Decimal(12, 2)
  monthlyRecovery Decimal  @db.Decimal(12, 2)
  recovered       Decimal  @default(0) @db.Decimal(12, 2)
  givenOn         DateTime @db.Date
  paidFrom        String   @default("BANK") // CASH_DRAWER | BANK
  status          String   @default("OPEN") // OPEN | CLOSED
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())

  @@index([tenantId, outletId])
  @@index([staffId, status])
  @@map("salary_advances")
}

model PayrollRun {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String
  month         String // "YYYY-MM"
  status        String    @default("DRAFT") // DRAFT | FINALISED (locked)
  config        Json // settings snapshot used for this run
  createdById   String?
  finalisedById String?
  finalisedAt   DateTime?
  createdAt     DateTime  @default(now())

  payslips Payslip[]

  @@unique([outletId, month])
  @@index([tenantId, outletId])
  @@map("payroll_runs")
}

model Payslip {
  id              String  @id @default(cuid())
  tenantId        String
  runId           String
  staffId         String
  staffName       String
  employeeCode    String
  designation     String?
  payType         String
  payRate         Decimal @db.Decimal(12, 2)
  inputs          Json // pay profile snapshot + attendance summary
  lopDays         Decimal @db.Decimal(5, 1)
  overtimeMinutes Int     @default(0)
  adjustments     Json? // [{ name, amount, kind }]
  calc            Json // PayslipCalc
  gross           Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  net             Decimal @db.Decimal(12, 2)
  employerCost    Decimal @db.Decimal(12, 2) // gross + employer PF/ESI
  advanceRecovery Decimal @default(0) @db.Decimal(12, 2)
  note            String?

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, staffId])
  @@index([tenantId])
  @@map("payslips")
}

model ExpenseCategory {
  id         String  @id @default(cuid())
  tenantId   String
  name       String
  ledgerName String?
  isActive   Boolean @default(true)

  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Expense {
  id             String    @id @default(cuid())
  tenantId       String
  outletId       String
  categoryId     String
  date           DateTime  @db.Date
  taxableAmount  Decimal   @db.Decimal(12, 2)
  cgst           Decimal   @default(0) @db.Decimal(12, 2)
  sgst           Decimal   @default(0) @db.Decimal(12, 2)
  igst           Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  itcEligible    Boolean   @default(true)
  vendorName     String?
  vendorGstin    String?
  invoiceNumber  String?
  paidFrom       String // CASH_DRAWER | BANK | UPI | CARD | PAYABLE
  reference      String?
  note           String?
  attachmentUrl  String?
  cashMovementId String?   @unique // the drawer movement when paid from the cash drawer
  createdById    String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime  @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId, outletId, date])
  @@map("expenses")
}

// Prepaid gift cards and refund store credit. Tenant-wide: redeemable at any outlet.
model GiftCard {
  id             String    @id @default(cuid())
  tenantId       String
  issuedOutletId String
  code           String
  kind           String    @default("GIFT_CARD") // GIFT_CARD | STORE_CREDIT
  initialValue   Decimal   @db.Decimal(12, 2)
  balance        Decimal   @db.Decimal(12, 2)
  expiresOn      DateTime? @db.Date // usable through the end of this IST date
  status         String    @default("ACTIVE") // ACTIVE | VOID
  customerName   String?
  customerPhone  String?
  note           String?
  issuedById     String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime  @default(now())

  txns GiftCardTxn[]

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@map("gift_cards")
}

// Append-only ledger; GiftCard.balance is the running balance.
model GiftCardTxn {
  id           String   @id @default(cuid())
  tenantId     String
  giftCardId   String
  outletId     String
  type         String // ISSUE | REDEEM | VOID | STORE_CREDIT
  amount       Decimal  @db.Decimal(12, 2) // signed
  balanceAfter Decimal  @db.Decimal(12, 2)
  orderId      String?
  paymentMode  String? // how a sale was paid (ISSUE)
  userId       String?
  note         String?
  createdAt    DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id])

  @@index([giftCardId, createdAt])
  @@index([tenantId, outletId, createdAt])
  @@map("gift_card_txns")
}

// ── Offline edge POS ─────
// An activated offline edge terminal. Authenticates /edge/device/* with a bearer
// secret (stored hashed) and owns its own GST invoice series (`seriesCode`).
model EdgeDevice {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String
  terminalId    String
  seriesCode    String // e.g. "E03" — re-activation always allocates a fresh series
  secretHash    String // sha256 of the device bearer secret
  activatedById String?
  activatedAt   DateTime  @default(now())
  lastPushAt    DateTime?
  lastPullAt    DateTime?
  clockSkewMs   Int? // serverTime − deviceTime measured on the last push
  revokedAt     DateTime?

  @@unique([outletId, seriesCode])
  @@index([tenantId, outletId])
  @@index([terminalId])
  @@map("edge_devices")
}

// Materialised per-outlet change feed: one row per catalog entity with a content
// hash; `seq` is bumped (from EdgeFeedState) whenever the hash changes or the
// entity disappears (tombstone). Devices pull rows with seq > cursor.
model EdgeFeedEntry {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String
  entity    String // settings | category | item | combo | area | table | staff | coupon
  entityId  String
  hash      String
  seq       Int
  deleted   Boolean  @default(false)
  data      Json?
  updatedAt DateTime @updatedAt

  @@unique([outletId, entity, entityId])
  @@index([outletId, seq])
  @@map("edge_feed_entries")
}

// Per-outlet feed sequence + serialisation lock for feed refreshes.
model EdgeFeedState {
  outletId    String   @id
  tenantId    String
  lastSeq     Int      @default(0)
  refreshedAt DateTime @default(now())

  @@map("edge_feed_states")
}

// Hashed offline PIN for a staff user (verified on the edge device).
model EdgeStaffPin {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  pinHash   String
  setById   String?
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("edge_staff_pins")
}

// Every offline invoice number accepted from a device series. The unique key makes
// a re-used number impossible and lets the console report gaps per series/FY.
model EdgeInvoiceSeq {
  id           String   @id @default(cuid())
  tenantId     String
  outletId     String
  edgeDeviceId String
  seriesCode   String
  fiscalYear   String
  seq          Int
  billNumber   String
  orderId      String
  createdAt    DateTime @default(now())

  @@unique([edgeDeviceId, fiscalYear, seq])
  @@unique([outletId, billNumber])
  @@index([tenantId, outletId])
  @@map("edge_invoice_seqs")
}

// Something about an offline sale that the server could not honour exactly
// (exhausted coupon, price drift, unknown staff…). The sale is kept; a manager reviews.
model EdgeSyncConflict {
  id             String    @id @default(cuid())
  tenantId       String
  outletId       String
  edgeDeviceId   String
  clientId       String
  orderId        String?
  billNumber     String?
  kind           String
  message        String
  detail         Json?
  status         String    @default("OPEN") // OPEN | RESOLVED
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())

  @@index([tenantId, outletId, status])
  @@map("edge_sync_conflicts")
}

// ── Billing ─────────────────────────────────────────────────────────────────

// Per-outlet billing rules. One row per outlet, created on first save; absent =
// defaults (no service charge, no round-off, IST).
model OutletBillingSettings {
  id                      String   @id @default(cuid())
  tenantId                String
  outletId                String   @unique
  serviceChargeEnabled    Boolean  @default(false)
  serviceChargePercent    Decimal  @default(0) @db.Decimal(5, 2)
  serviceChargeTaxable    Boolean  @default(true)
  serviceChargeOrderTypes String[] @default(["DINE_IN"])
  roundOffEnabled         Boolean  @default(false)
  timezone                String   @default("Asia/Kolkata") // drives item availability windows
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
  @@map("outlet_billing_settings")
}

// A cart parked server-side (held order) so any terminal can resume it.
model ParkedCart {
  id            String   @id @default(cuid())
  tenantId      String
  outletId      String
  label         String
  orderType     String
  tableId       String?
  orderId       String? // pending additions to this running order
  customerName  String?
  customerPhone String?
  lines         Json
  itemCount     Int      @default(0)
  amount        Decimal  @default(0) @db.Decimal(10, 2)
  parkedById    String?
  createdAt     DateTime @default(now())

  @@index([tenantId, outletId])
  @@map("parked_carts")
}

// ── Printing ─────
// LAN receipt/KOT printers. The cloud API never talks to a printer: it records
// print jobs, and an on-premise edge print agent (NETWORK/USB) or a POS browser
// (BROWSER) claims and delivers them.
model Printer {
  id            String   @id @default(cuid())
  tenantId      String
  outletId      String
  name          String
  connection    String   @default("BROWSER") // NETWORK | USB | BROWSER
  host          String?
  port          Int      @default(9100)
  usbPath       String?
  paperWidth    Int      @default(80) // 58 | 80
  codepage      String   @default("CP437")
  printKots     Boolean  @default(false)
  printBills    Boolean  @default(false)
  stationIds    Json? // string[]; empty/null = every station
  copies        Int      @default(1)
  autoPrintKot  Boolean  @default(true)
  autoPrintBill Boolean  @default(true)
  drawerKick    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs PrintJob[]

  @@index([tenantId, outletId])
  @@map("printers")
}

// Bill header/footer details for an outlet's printed bills.
model OutletPrintSettings {
  id          String   @id @default(cuid())
  tenantId    String
  outletId    String   @unique
  fssaiNumber String?
  headerLines Json? // string[]
  footerLines Json? // string[]
  upiQrOnBill Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("outlet_print_settings")
}

model PrintJob {
  id          String    @id @default(cuid())
  tenantId    String
  outletId    String
  printerId   String?
  kind        String // KOT | BILL | TEST | DRAWER
  status      String    @default("QUEUED") // QUEUED | PRINTING | PRINTED | FAILED | CANCELLED
  payload     Json // PrintPayload snapshot — reprints print exactly what was sent
  copies      Int       @default(1)
  reprint     Boolean   @default(false)
  openDrawer  Boolean   @default(false)
  orderId     String?
  kotId       String?
  // Idempotency key for automatic jobs (one auto KOT per kot+printer).
  sourceKey   String?   @unique
  attempts    Int       @default(0)
  error       String?
  claimedBy   String?
  claimedAt   DateTime?
  printedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  printer Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  @@index([tenantId, outletId, status, createdAt])
  @@index([orderId])
  @@map("print_jobs")
}

// ── Front of house ─────────────────────────────────────────────────────────

// Per-area floor canvas for the visual floor plan (logical units, not pixels).
model FloorPlan {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String
  areaId    String   @unique
  width     Int      @default(1000)
  height    Int      @default(700)
  updatedAt DateTime @updatedAt

  placements TablePlacement[]

  @@index([tenantId, outletId])
  @@map("floor_plans")
}

// Where a dining table sits on its area's floor plan.
model TablePlacement {
  id          String @id @default(cuid())
  tenantId    String
  outletId    String
  floorPlanId String
  tableId     String @unique
  x           Int
  y           Int
  width       Int
  height      Int
  rotation    Int    @default(0) // degrees, 0..359
  shape       String @default("SQUARE") // ROUND | SQUARE | RECT

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId])
  @@map("table_placements")
}

model Reservation {
  id              String    @id @default(cuid())
  tenantId        String
  outletId        String
  guestName       String
  phone           String
  partySize       Int
  startAt         DateTime
  durationMinutes Int       @default(90)
  status          String    @default("BOOKED") // BOOKED | CONFIRMED | SEATED | NO_SHOW | CANCELLED
  source          String    @default("PHONE") // PHONE | WALK_IN | WEB | AGGREGATOR | OTHER
  notes           String?
  customerId      String? // CRM customer matched by phone
  createdById     String?
  seatedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tables ReservationTable[]

  @@index([tenantId, outletId, startAt])
  @@map("reservations")
}

model ReservationTable {
  reservationId String
  tableId       String

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@id([reservationId, tableId])
  @@index([tableId])
  @@map("reservation_tables")
}

model WaitlistEntry {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String
  guestName     String
  phone         String?
  partySize     Int
  quotedMinutes Int       @default(15)
  status        String    @default("WAITING") // WAITING | NOTIFIED | SEATED | LEFT
  notes         String?
  tableId       String?
  customerId    String?
  notifiedAt    DateTime?
  seatedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, outletId, status])
  @@map("waitlist_entries")
}

// A diner (or staff) request for service at a table.
model ServerCall {
  id               String    @id @default(cuid())
  tenantId         String
  outletId         String
  tableId          String
  type             String // WAITER | WATER | BILL
  source           String    @default("DINER") // DINER | STAFF
  status           String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  createdById      String?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([tenantId, outletId, status])
  @@index([tableId, status])
  @@map("server_calls")
}

// A waiter's section: either a whole area or a single table.
model WaiterAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String
  userId    String
  areaId    String?
  tableId   String?
  createdAt DateTime @default(now())

  @@index([outletId, userId])
  @@index([tenantId, outletId])
  @@map("waiter_assignments")
}

// The bill for a running order was requested/printed (floor shows "bill printed").
model BillRequest {
  id            String   @id @default(cuid())
  tenantId      String
  outletId      String
  orderId       String   @unique
  tableId       String?
  requestedById String?
  createdAt     DateTime @default(now())

  @@index([tenantId, outletId])
  @@map("bill_requests")
}

// A customer-facing display paired to a POS. The display holds `token` (secret);
// staff pair it by typing the short `pairingCode` shown on screen.
model CfdSession {
  id          String    @id @default(cuid())
  tenantId    String?
  outletId    String?
  token       String    @unique
  pairingCode String    @unique
  pairedById  String?
  pairedAt    DateTime?
  state       Json?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, outletId])
  @@map("cfd_sessions")
}
