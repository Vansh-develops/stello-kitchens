DATABASE_URL="postgresql://stello:stello@localhost:5455/stello?schema=public"
# REQUIRED in production (NODE_ENV=production) — the app refuses to boot if unset.
JWT_SECRET="dev-secret-change-me"
PORT=3001
# REQUIRED in production — service-to-service key for the connector. App fails fast if unset.
CONNECTOR_KEY="dev-connector-key"
# Optional. Comma-separated allowed browser origins for CORS. If unset in
# production, defaults to https://kitchens.stellotechs.com. Dev reflects any origin.
# CORS_ORIGINS="https://kitchens.stellotechs.com,https://order.stellotechs.com"

# ── Real providers (track 4). Each is OFF (mock/logging) unless its vars are set. ──
# Background reconciliation loops (payments recovery, messaging outbox, low-stock sweep).
# INTEGRATION_JOBS=off
# PAYMENTS_RECOVERY_INTERVAL_MS=60000
# MESSAGING_DISPATCH_INTERVAL_MS=5000
# LOW_STOCK_SWEEP_INTERVAL_MS=60000

# Razorpay (dashboard → Settings → API Keys / Webhooks). Webhook URL:
#   https://<api-host>/api/v1/webhooks/razorpay  events: qr_code.credited, payment_link.paid,
#   payment.captured, refund.processed, refund.failed
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_COLLECT_KIND=QR   # QR (needs UPI QR Codes enabled on the account) | LINK

# MSG91 (SMS). OTP + transactional/promotional templates must be DLT-approved and linked in MSG91.
# Delivery-report webhook URL: https://<api-host>/api/v1/webhooks/msg91/<MSG91_WEBHOOK_TOKEN>
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=STELLO
# MSG91_WEBHOOK_TOKEN=

# Meta WhatsApp Cloud API. Webhook URL: https://<api-host>/api/v1/webhooks/whatsapp
# WHATSAPP_ACCESS_TOKEN=       # system-user permanent token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=         # verifies X-Hub-Signature-256
# WHATSAPP_VERIFY_TOKEN=       # any string; entered in the Meta webhook setup
# WHATSAPP_GRAPH_VERSION=v21.0

# SMTP (any ESP relay). Unset → emails are logged.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Stello Kitchens <no-reply@stellotechs.com>"

# GST e-invoicing via Masters India GSP. Sandbox: https://sandb-api.mastersindia.co
# Production: https://router.mastersindia.co
# MASTERS_INDIA_BASE_URL=https://sandb-api.mastersindia.co
# MASTERS_INDIA_USERNAME=
# MASTERS_INDIA_PASSWORD=

# Aggregator connector (outbound menu/stock/store/order-status relay).
# CONNECTOR_URL=http://localhost:3003
# AGGREGATOR_AUTO_STOCK_SYNC=off
