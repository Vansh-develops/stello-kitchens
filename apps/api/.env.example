DATABASE_URL="postgresql://stello:stello@localhost:5455/stello?schema=public"
# REQUIRED in production (NODE_ENV=production) — the app refuses to boot if unset.
JWT_SECRET="dev-secret-change-me"
PORT=3001
# REQUIRED in production — service-to-service key for the connector. App fails fast if unset.
CONNECTOR_KEY="dev-connector-key"
# Optional. Comma-separated allowed browser origins for CORS. If unset in
# production, defaults to https://kitchens.stellotechs.com. Dev reflects any origin.
# CORS_ORIGINS="https://kitchens.stellotechs.com,https://order.stellotechs.com"

# ── Printing ──
# No API env vars: the cloud never connects to printers. LAN delivery is done by
# the edge print agent (apps/edge, see EDGE_PRINT_* in apps/edge/README.md) or by
# the POS browser.
# Menu photo storage. Defaults to local disk (MEDIA_DIR, served at /api/v1/media/...).
# Set S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY to use any S3-compatible
# store (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces).
# MEDIA_DIR="./uploads"
# MEDIA_MAX_BYTES=2097152
# S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# S3_REGION="ap-south-1"
# S3_BUCKET="stello-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Public base URL objects are readable from (bucket website / CDN). Defaults to <endpoint>/<bucket>.
# S3_PUBLIC_BASE_URL="https://cdn.example.com"
# ── Platform & security ─────
# Key for encrypting TOTP seeds and webhook signing secrets at rest (any long
# random string). Falls back to a key derived from JWT_SECRET when unset;
# set it explicitly in production so rotating JWT_SECRET doesn't orphan 2FA.
# DATA_ENCRYPTION_KEY="change-me-to-a-long-random-string"
# Session cookies are always Secure in production; set true to force Secure in
# other environments served over https. COOKIE_DOMAIN shares the session across
# subdomains (leave unset for host-only cookies).
# COOKIE_SECURE="true"
# COOKIE_DOMAIN=".stellotechs.com"
# Outbound webhooks: the delivery worker polls every WEBHOOK_WORKER_INTERVAL_MS.
# Private/loopback targets are refused in production unless WEBHOOK_ALLOW_PRIVATE=true.
# WEBHOOK_WORKER_INTERVAL_MS=5000
# WEBHOOK_WORKER_DISABLED="false"
# WEBHOOK_ALLOW_PRIVATE="false"
# Scheduled report emails: scheduler tick (ms) and kill switch.
# REPORT_SCHEDULER_INTERVAL_MS=60000
# REPORT_SCHEDULER_DISABLED="false"
# SaaS subscription billing (Stello's own plans; separate from restaurant-bill payments).
# Razorpay Subscriptions is used when both keys are set; otherwise a mock provider
# activates subscriptions and "collects" invoices instantly. Webhook URL:
#   POST /api/v1/public/subscription/webhook/razorpay
# SAAS_BILLING_RAZORPAY_KEY_ID="rzp_live_xxx"
# SAAS_BILLING_RAZORPAY_KEY_SECRET="xxx"
# SAAS_BILLING_RAZORPAY_WEBHOOK_SECRET="xxx"
# Dev/testing only: make the mock provider fail every charge (exercise PAST_DUE / SUSPENDED).
# SAAS_BILLING_MOCK_FAIL=1
# Set to 1 to disable the hourly subscription lifecycle sweep (trial expiry, grace, renewals).
# SAAS_BILLING_CYCLE_DISABLED=1
