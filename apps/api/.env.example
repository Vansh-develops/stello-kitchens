DATABASE_URL="postgresql://stello:stello@localhost:5455/stello?schema=public"
# REQUIRED in production (NODE_ENV=production) — the app refuses to boot if unset.
JWT_SECRET="dev-secret-change-me"
PORT=3001
# REQUIRED in production — service-to-service key for the connector. App fails fast if unset.
CONNECTOR_KEY="dev-connector-key"
# Optional. Comma-separated allowed browser origins for CORS. If unset in
# production, defaults to https://kitchens.stellotechs.com. Dev reflects any origin.
# CORS_ORIGINS="https://kitchens.stellotechs.com,https://order.stellotechs.com"
# SaaS subscription billing (Stello's own plans; separate from restaurant-bill payments).
# Razorpay Subscriptions is used when both keys are set; otherwise a mock provider
# activates subscriptions and "collects" invoices instantly. Webhook URL:
#   POST /api/v1/public/subscription/webhook/razorpay
# SAAS_BILLING_RAZORPAY_KEY_ID="rzp_live_xxx"
# SAAS_BILLING_RAZORPAY_KEY_SECRET="xxx"
# SAAS_BILLING_RAZORPAY_WEBHOOK_SECRET="xxx"
# Dev/testing only: make the mock provider fail every charge (exercise PAST_DUE / SUSPENDED).
# SAAS_BILLING_MOCK_FAIL=1
# Set to 1 to disable the hourly subscription lifecycle sweep (trial expiry, grace, renewals).
# SAAS_BILLING_CYCLE_DISABLED=1
